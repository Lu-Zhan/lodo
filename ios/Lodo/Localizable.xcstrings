{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "AI 个性": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Personality"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 个性"
          }
        }
      }
    },
    "AI 会在事项完成后归纳\"类型 → 典型时长\",新建没说时长的事项时据此建议。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI summarizes \"type → typical duration\" after tasks are completed, and suggests a duration for new tasks that don't specify one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 会在事项完成后归纳\"类型 → 典型时长\",新建没说时长的事项时据此建议。"
          }
        }
      }
    },
    "AI 修改": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Edit"
          }
        },
