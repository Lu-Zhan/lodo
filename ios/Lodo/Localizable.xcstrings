        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you grant access, your calendar events appear here and you can tap any of them to edit. lodo never changes anything on its own—every edit needs your confirmation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权后这里会显示你日历里的日程,点开任意一条可以直接修改。lodo 不会替你改任何内容,改动都要你在编辑界面里确认。"
          }
        }
      }
    },
